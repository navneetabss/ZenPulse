PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/healthcare_pro

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
JWT_RESET_SECRET=change_this_to_another_long_random_secret
JWT_RESET_EXPIRE=15m

# Frontend URL (used in reset-password links, CORS)
CLIENT_URL=http://localhost:5173
